{
  "name": "ray-color",
  "version": "0.4.0",
  "description": "Generative color palettes from a raytraced scene — edit the conditions, not the colors",
  "type": "module",
  "main": "./lib/ray-color.cjs",
  "module": "./lib/ray-color.js",
  "types": "./lib/engine.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./lib/engine.d.ts",
        "default": "./lib/ray-color.js"
      },
      "require": {
        "types": "./lib/engine.d.cts",
        "default": "./lib/ray-color.cjs"
      }
    },
    "./view": {
      "types": "./lib/view.d.ts",
      "import": "./lib/view.js"
    },
    "./view/webgl": {
      "types": "./lib/view-webgl.d.ts",
      "import": "./lib/view-webgl.js"
    },
    "./view/software": {
      "types": "./lib/view-software.d.ts",
      "import": "./lib/view-software.js"
    }
  },
  "files": [
    "lib"
  ],
  "sideEffects": [
    "./lib/view.js",
    "./lib/view-webgl.js",
    "./lib/view-software.js",
    "./src/view.ts",
    "./src/view-webgl.ts",
    "./src/view-software.ts"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:lib": "vite build --config vite.lib.config.ts && tsc -p tsconfig.lib.json && cp lib/engine.d.ts lib/engine.d.cts",
    "test": "npm run build:lib && node --test \"test/*.test.mjs\"",
    "preview": "vite preview",
    "prepublishOnly": "npm run build:lib"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meodai/ray-color.git"
  },
  "homepage": "https://meodai.github.io/ray-color/",
  "bugs": {
    "url": "https://github.com/meodai/ray-color/issues"
  },
  "keywords": [
    "color",
    "color-palette",
    "palette-generator",
    "raytracer",
    "generative",
    "color-scheme"
  ],
  "author": "David Aerne <meodai@gmail.com> (https://github.com/meodai)",
  "license": "MIT",
  "devDependencies": {
    "token-beam": "^1.32.0",
    "typescript": "~5.8.3",
    "vite": "^7.1.2"
  }
}
