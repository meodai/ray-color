{
  "name": "ray-color",
  "version": "0.1.0",
  "description": "Generative color palettes from a raytraced scene — edit the conditions, not the colors",
  "type": "module",
  "main": "./lib/ray-color.cjs",
  "module": "./lib/ray-color.js",
  "types": "./lib/engine.d.ts",
  "exports": {
    ".": {
      "types": "./lib/engine.d.ts",
      "import": "./lib/ray-color.js",
      "require": "./lib/ray-color.cjs"
    }
  },
  "files": [
    "lib"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:lib": "vite build --config vite.lib.config.ts && tsc -p tsconfig.lib.json",
    "preview": "vite preview",
    "prepublishOnly": "npm run build:lib"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meodai/ray-color.git"
  },
  "homepage": "https://meodai.github.io/ray-color/",
  "bugs": {
    "url": "https://github.com/meodai/ray-color/issues"
  },
  "keywords": [
    "color",
    "color-palette",
    "palette-generator",
    "raytracer",
    "generative",
    "color-scheme"
  ],
  "author": "David Aerne <meodai@gmail.com> (https://github.com/meodai)",
  "license": "MIT",
  "devDependencies": {
    "typescript": "~5.8.3",
    "vite": "^7.1.2",
    "token-beam": "^1.9.0"
  }
}
